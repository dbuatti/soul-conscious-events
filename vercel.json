{
  "functions": {
    "api/page-meta.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/events/:id",
      "missing": [{ "type": "query", "key": "spa" }],
      "destination": "/api/page-meta?type=event&id=:id"
    },
    {
      "source": "/:slug(melbourne|sydney|brisbane|perth|adelaide|hobart|canberra|darwin)",
      "missing": [{ "type": "query", "key": "spa" }],
      "destination": "/api/page-meta?type=city&slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
